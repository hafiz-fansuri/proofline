# Frontend public connection identifiers are configured in src/config.json.
# Owner-only corpus seeding environment (local shell, never frontend):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-key
# Server-only Supabase Edge Function secrets (never VITE_ variables):
# RAGS=your-openrouter-key
# OPENROUTER_API_KEY=alternative-secret-name
# OPENROUTER_MODEL=an-explicit-model-id-ending-in-:free
